# Optional. Leave unset for the demo OTP flow.
#
# Point this at a small backend that verifies numbers and sends the code
# (MSG91/Twilio for SMS, or Truecaller's partner API). Contract:
#
#   POST  { phone: "9876543210", channel: "sms" | "truecaller" }
#   200   { "provider": "backend" | "truecaller", "profile": { "name": "..." } }
#
# Never put provider keys in VITE_* variables — Vite inlines them into the
# public bundle. Only the endpoint URL belongs here.
VITE_OTP_ENDPOINT=
